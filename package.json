{
  "name": "multiple-apps",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^24.19.0"
  },
  "scripts": {
    "prepare": "husky",
    "graph": "turbo devtools",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "prepare:types": "turbo run postinstall",
    "typecheck": "turbo run typecheck",
    "dev:f1": "pnpm --filter @multi/f1 dev",
    "dev:portal": "pnpm --filter @multi/portal dev",
    "typecheck:portal": "pnpm --filter @multi/portal typecheck"
  },
  "devDependencies": {
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "turbo": "catalog:"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{js,mjs,ts,vue,json}": "eslint --fix --no-warn-ignored"
  }
}
