{
  "name": "multiple-apps",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^24.19.0"
  },
  "scripts": {
    "prepare": "husky",
    "graph": "turbo devtools",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "dev:portal": "pnpm --filter @multi/portal dev",
    "dev:hub": "pnpm --filter @multi/hub dev",
    "dev:admin": "pnpm --filter @multi/admin dev",
    "dev:currency": "pnpm --filter @multi/currency dev",
    "typecheck:portal": "pnpm --filter @multi/portal typecheck",
    "typecheck:hub": "pnpm --filter @multi/hub typecheck",
    "typecheck:admin": "pnpm --filter @multi/admin typecheck",
    "lint:hub": "pnpm --filter @multi/hub lint",
    "lint-fix:hub": "pnpm --filter @multi/hub exec eslint . --fix"
  },
  "devDependencies": {
    "turbo": "catalog:",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{js,mjs,ts,vue,json}": "eslint --fix"
  }
}
