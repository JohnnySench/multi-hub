# Скопировать в .env и заполнить
# Абсолютный URL развёрнутого сайта (используется nuxt-og-image при pnpm generate)
NUXT_SITE_URL=https://f1.example.com
NUXT_F1_BASE_URL=https://api.openf1.org/v1
# live | record | replay
NUXT_F1_API_MODE=live
# Задержка ответа моков в replay, мс (0 — без задержки)
NUXT_F1_MOCK_DELAY=0
# Подпись OG-картинок nuxt-og-image: минимум 32 символа, сгенерировать: npx nuxt-og-image generate-secret
NUXT_APP_SECRET=
# Postgres: локальный Docker или Neon
NUXT_DB_URL=postgres://postgres:***@localhost:5432/f1

NUXT_VAPID_KEY_SECRET=
NUXT_PUBLIC_VAPID_KEY=
NUXT_VAPID_SUBJECT_SECRET=

